APP_ENV=development
APP_NAME=VaultTrace
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql+psycopg://your_db_user:replace-me@localhost:5432/vaulttrace
POSTGRES_DB=vaulttrace
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=replace-me
JWT_SECRET_KEY=generate-a-random-secret-before-use
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
OTP_HASH_SECRET=generate-a-separate-random-secret-before-use
OTP_EXPIRATION_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5
OTP_MAX_ATTEMPTS=5
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=vaulttrace@localhost
SMTP_STARTTLS=false
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=vaulttrace@localhost
SMTP_USE_TLS=false
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=10
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_USERNAME=bootstrap-admin
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-long-random-password
ADMIN_BOOTSTRAP_FULL_NAME=VaultTrace Administrator
VITE_API_BASE_URL=http://localhost:8000/api/v1
