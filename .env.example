APP_ENV=development
APP_NAME=VaultTrace
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql+psycopg://your_db_user:replace-me@localhost:5432/vaulttrace
# Set both only when intentionally running Alembic against production.
PRODUCTION_DATABASE_URL=postgresql+psycopg://your_db_user:replace-me@your-production-host:5432/your_db
ALEMBIC_USE_PRODUCTION_DATABASE=false
POSTGRES_DB=vaulttrace
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=replace-me
JWT_SECRET_KEY=generate-a-random-secret-before-use
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
OTP_HASH_SECRET=generate-a-separate-random-secret-before-use
OTP_EXPIRATION_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=10
OTP_MAX_ATTEMPTS=5
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=vaulttrace@localhost
SMTP_STARTTLS=false
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=vaulttrace@localhost
# Optional legacy override. If set, this takes precedence over SMTP_STARTTLS.
# Leave unset when configuring SMTP_STARTTLS.
# SMTP_USE_TLS=true
# Gmail production example (set in Render; never commit real credentials):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-sending-address@gmail.com
# SMTP_PASSWORD=your-google-app-password
# SMTP_FROM_EMAIL=your-sending-address@gmail.com
# SMTP_STARTTLS=true
# SMTP_USE_SSL=false
EMAIL_PROVIDER=mailpit
# For production on hosts that block SMTP, use Gmail API over HTTPS instead:
# EMAIL_PROVIDER=gmail_api
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# GMAIL_SENDER_EMAIL=
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=10
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./private_storage
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_USERNAME=bootstrap-admin
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-long-random-password
ADMIN_BOOTSTRAP_FULL_NAME=VaultTrace Administrator
ADMIN2_EMAIL=admin2@example.com
ADMIN2_USERNAME=bootstrap-admin-2
ADMIN2_PASSWORD=replace-with-a-different-long-random-password
ADMIN2_FULL_NAME=VaultTrace Administrator 2
VITE_API_BASE_URL=http://localhost:8000/api/v1
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=vaulttrace-documents
DOCUMENT_MAX_UPLOAD_BYTES=5242880
DOCUMENT_ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,txt,csv,docx,xlsx
VITE_DOCUMENT_MAX_UPLOAD_BYTES=5242880
VITE_DOCUMENT_ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,txt,csv,docx,xlsx
